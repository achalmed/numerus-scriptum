        "# Ajustar el diseño para evitar recortes\n",
        "plt.tight_layout()\n",
        "\n",
        "# Guardar la figura en un archivo (opcional, descomentar para usar)\n",
        "# plt.savefig('edades_alumnos_secundaria.png')\n",
        "\n",
        "# Mostrar el gráfico\n",
        "plt.show()"
