        "print(bool([]))       # False (lista vacía)\n",
        "print(bool({}))       # False (diccionario vacío)\n",
        "print(bool(None))     # False\n",
        "print(bool(False))    # False\n",
        "\n",
        "# Valores que evalúan a True\n",
        "print(bool(1))        # True\n",
        "print(bool(-1))       # True\n",
        "print(bool(0.1))      # True\n",
        "print(bool(\"texto\"))  # True\n",
        "print(bool([1, 2]))   # True\n",
        "print(bool({'a': 1})) # True"
