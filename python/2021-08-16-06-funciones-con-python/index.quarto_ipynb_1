        "print(f\"Monto 2: S/ {monto2:,.2f}\")\n",
        "\n",
        "# Especificar todos los argumentos\n",
        "monto3 = calcular_interes_compuesto(10000, 0.10, 3)\n",
        "print(f\"Monto 3: S/ {monto3:,.2f}\")"
