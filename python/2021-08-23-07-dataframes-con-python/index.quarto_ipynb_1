      "source": [
        "# Crear DataFrame de ventas\n",
        "ventas = pd.DataFrame({\n",
        "    'producto': ['A', 'B', 'C', 'D'],\n",
        "    'ene': [1000, 1500, 800, 1200],\n",
        "    'feb': [1100, 1400, 850, 1300],\n",
