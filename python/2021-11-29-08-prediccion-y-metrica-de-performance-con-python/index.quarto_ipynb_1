        "# Calcular curva\n",
        "recall_curva, precision_curva, umbrales_pr = calcular_curva_precision_recall(\n",
        "    y_test, probabilidades[:, 1]\n",
        ")\n",
        "\n",
        "# También usar sklearn\n",
        "precision_sklearn, recall_sklearn, _ = precision_recall_curve(\n",
