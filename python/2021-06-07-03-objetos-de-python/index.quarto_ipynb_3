        "    # Evaluar liquidez\n",
        "    if liquidez >= 2.0:\n",
        "        puntos += 3\n",
        "    elif liquidez >= 1.5:\n",
        "        puntos += 2\n",
        "    elif liquidez >= 1.0:\n",
        "        puntos += 1\n",
        "    \n",
        "    # Evaluar endeudamiento (menor es mejor)\n",
