      "source": [
        "# Cartera de inversiones\n",
        "cartera = {\n",
        "    'BBVA': {'cantidad': 100, 'precio_compra': 25.50, 'precio_actual': 27.80},\n",
        "    'BCP': {'cantidad': 150, 'precio_compra': 180.00, 'precio_actual': 195.50},\n",
