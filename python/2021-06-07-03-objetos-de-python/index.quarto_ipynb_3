        "    elif endeudamiento <= 0.5:\n",
        "        puntos += 2\n",
        "    elif endeudamiento <= 0.7:\n",
        "        puntos += 1\n",
        "    \n",
        "    # Evaluar rentabilidad\n",
        "    if rentabilidad >= 0.15:\n",
        "        puntos += 3\n",
        "    elif rentabilidad >= 0.10:\n",
        "        puntos += 2\n",
        "    elif rentabilidad >= 0.05:\n",
        "        puntos += 1\n",
        "    \n",
        "    # Determinar calificación\n",
        "    if puntos >= 8:\n",
        "        return 'AAA', puntos\n",
        "    elif puntos >= 6:\n",
        "        return 'AA', puntos\n",
